---
source: crates/tessera-config/tests/edit.rs
expression: restored
---
# Tessera configuration.
#
# This file was written by Tessera on first launch. Every key is optional and
# shown here with its default value; delete a key to return to the default.
# Edits are picked up while Tessera is running. Unknown keys are reported in
# the log and otherwise ignored, so a typo never prevents Tessera from
# starting.

[general]
# Profile used for new sessions when none is specified.
default_profile = "Default"
# Confirm before closing a window that still has running jobs.
confirm_close = true
# Mark a tab whose shell runs on another machine: "title" puts "⇢ host: "
# before its title (or "⇢ ssh" when ssh runs and the host is unknown), "off"
# leaves titles unchanged.
remote_indicator = "title"

[appearance]
# Theme name: a themes/*.toml file next to this file (by file stem or by the
# theme's `name` inside it), else a bundled theme: Tessera Dark, Tessera
# Light, Solarized Dark, Solarized Light, Dracula, Nord, Gruvbox Dark, One
# Dark, Tokyo Night or Catppuccin Mocha. Case does not matter, and any run of
# spaces or punctuation is one separator ("solarized-dark" is Solarized Dark;
# "+" reads as "plus").
theme = "Tessera Dark"
# Font family and size in points (4 to 512).
font_family = "Menlo"
font_size = 13.0
# Window opacity from 0.0 (invisible) to 1.0 (opaque), and whether to blur
# what is behind the window when it is translucent.
blur = false
# Blur radius for the whole window (0 to 64): 0 keeps the standard blur
# behind each pane that asks for it; above 0 blurs the window at that
# radius while every translucent pane of the tab asks for blur.
blur_radius = 0
# Cursor shape: "block", "underline" or "beam" (a vertical bar), and whether
# it blinks. Programs may change both (vim, fish); they come back to these
# when a program asks for the default or the terminal is reset. An edit of
# cursor_blink applies to open tabs at once, but tmux and vim turn blinking
# off on their own, so a running tmux may turn it off again. Blinking is not
# drawn yet.
cursor_shape = "block"
cursor_blink = false
# How much to darken the unfocused panes of a split tab, from 0.0 (off) to
# 0.8.
dim_inactive_panes = 0.0
# Tessera's own windows, menus and settings: "dark", "light" or "system"
# (follow System Settings > Appearance). The terminal's colours stay the
# theme's.
app_appearance = "dark"

[terminal]
# Maximum number of lines kept in scrollback per pane.
scrollback_lines = 10000
# Shell integration for zsh and fish (bash support is to follow): "auto"
# makes the shells Tessera starts load its scripts (prompt marks, working
# directory reports); "off" starts them unchanged. TESSERA_SHELL_INTEGRATION=0 in a shell's
# environment turns it off for that shell.
shell_integration = "auto"
# Whether programs may write the clipboard with OSC 52 (tmux, Neovim, also
# over ssh), up to 1 MiB of text per write. Programs can never read it.
clipboard_write = true

# Named profiles. Each profile may override `command`, `working_directory`
# and `appearance`. The first profile is used when `general.default_profile`
# does not match any name.
#
# [[profiles]]
# name = "Default"
# command = "/bin/zsh -l"
# working_directory = "~"
# [profiles.appearance]
# font_size = 14.0

# Key bindings: a chord (always quoted) and a command, `send_text:` and the
# text to type, "unbound" (drop a default chord) or "none" (swallow the key).
# The menus show the chords; docs/config.md lists every chord and command.
#
# [keys]
# "cmd+u" = "new_tab"
# "ctrl+shift+k" = "send_text:clear\n"
# "cmd+q" = "unbound"

[selection]
# Whether Copy drops the blanks after the last text of each line.
trim_trailing_whitespace = true
# A double-click selects the best match of the smart selection rules that
# covers the click (paths, URLs, email and IP addresses, git hashes, quoted
# strings by default), else the word. A list replaces the built-in rules;
# precision is "very_low", "low", "normal", "high" or "very_high".
#
# [[selection.smart_rules]]
# regex = '[A-Z]+-[0-9]+'
# precision = "high"

[plugins]
# Plugin ids to enable.
enabled = []

[keys]
