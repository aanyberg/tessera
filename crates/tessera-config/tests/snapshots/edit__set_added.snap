---
source: crates/tessera-config/tests/edit.rs
expression: read(&path)
---
# My Tessera setup.
# Synced from dotfiles.

[general]
confirm_close   =   false    # I live dangerously
fancy_unknown = "kept"

[appearance]
# Colours.

# The theme I like.
theme = 'Nord'
font_size = 13.5 # points
# Fully opaque.
opacity = 1.0
blur = true
# ...and nothing after this.

[terminal]
scrollback_lines = 50_000
clipboard_write = true

# Plugins come last.
[plugins]
enabled = [
  "hello", # the demo
  "other",
  # nothing else yet
]

[[profiles]]
name = "Work"
appearance.theme = "Dracula"
command = "/usr/bin/fish"

[[profiles]]
# My shell.
name = "Shell"
command = "/bin/zsh -l"
[profiles.appearance]
font_size = 15.0

[[profiles]]
name = "Remote"

[profiles.appearance]
theme = "Nord"

[keys]
"cmd+e" = "new_tab"  # muscle memory
"cmd+d" = "split_right"
